# ── TripListik Backend Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
DSN=postgres://user:password@host:5432/dbname?sslmode=require

# ── HTTP Server ───────────────────────────────────────────────────────────────
# Address to listen on. Defaults to :8080.
# On Render, set PORT instead (the platform injects it automatically).
# HTTP_ADDR=:8080
# PORT=8080

# Application environment: "dev" or "prod" (default: dev)
APP_ENV=dev

# Comma-separated list of allowed CORS origins. Use "*" to allow all (default).
CORS_ORIGINS=http://localhost:5173

# ── Authentication ────────────────────────────────────────────────────────────
# Secret used to sign JWT access and refresh tokens (required, min 32 chars)
JWT_SECRET=change_me_to_a_long_random_secret

# Telegram Web App HMAC secret — found in BotFather as the bot token.
# Used to verify initData from the Telegram Mini App (required).
TELEGRAM_WEBAPP_SECRET=your_bot_token_here

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# Bot token from BotFather. Used to send invite notifications and /start messages.
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Public HTTPS URL of the Mini App frontend. Used to construct deep-link buttons
# in invite notifications. If unset, plain-text notifications are sent instead.
MINI_APP_URL=https://your-frontend.onrender.com

# ── Supabase ──────────────────────────────────────────────────────────────────
# Your Supabase project URL (e.g. https://xyzxyz.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (safe to expose to the browser)
SUPABASE_ANON_KEY=eyJ...

# Supabase service role key — KEEP THIS SECRET, never expose to the browser.
# Used by the backend to sign upload URLs and manage storage.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Supabase JWT secret — used to verify Supabase-signed tokens server-side.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Storage bucket name for trip photos (default: trip-photos)
SUPABASE_STORAGE_BUCKET=trip-photos

# ── AI / Optional ─────────────────────────────────────────────────────────────
# API key for the AI provider (optional, only needed if AI features are enabled)
# API_KEY_AI=sk-...
